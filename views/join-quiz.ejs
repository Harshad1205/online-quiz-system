<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Examination Entry Room — AcademiQuiz</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex items-center justify-center p-4 selection:bg-indigo-500 selection:text-white relative overflow-hidden">

    <!-- Ambient Glow Effects -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-md w-full relative z-10 py-6">
        
        <!-- Header Branding -->
        <div class="text-center mb-8">
            <a href="/" class="inline-block transition-transform hover:scale-105">
                <div class="h-14 w-14 rounded-2xl bg-gradient-to-tr from-indigo-600 to-sky-400 text-white flex items-center justify-center font-extrabold text-2xl mx-auto shadow-xl shadow-indigo-500/20 ring-1 ring-white/20 mb-4">
                    ✍️
                </div>
            </a>
            <h1 class="text-2xl md:text-3xl font-black text-white tracking-tight">Student Exam Access</h1>
            <p class="text-slate-400 text-xs md:text-sm mt-1.5 font-medium">Enter your credentials and official session PIN to proceed</p>
        </div>

        <!-- Form Card -->
        <div class="bg-slate-900/90 border border-slate-800/90 backdrop-blur-2xl p-8 rounded-3xl shadow-2xl space-y-6">
            
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-semibold flex items-center gap-2.5">
                    <span class="text-base shrink-0">⚠️</span>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form action="/join" method="POST" class="space-y-4">
                <div>
                    <label for="studentName" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Full Student Name</label>
                    <input 
                        type="text" 
                        id="studentName"
                        name="studentName" 
                        placeholder="e.g. John Doe" 
                        required
                        class="w-full bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition shadow-inner"
                    >
                </div>

                <div>
                    <label for="studentEmail" class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Official Student Email</label>
                    <input 
                        type="email" 
                        id="studentEmail"
                        name="studentEmail" 
                        placeholder="student@college.edu.in" 
                        required
                        class="w-full bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition shadow-inner"
                    >
                </div>

                <div>
                    <label for="quizCode" class="block text-xs font-bold uppercase tracking-wider text-indigo-400 mb-2">
                        6-Character Quiz Code (PIN)
                    </label>
                    <input 
                        type="text" 
                        id="quizCode"
                        name="quizCode" 
                        placeholder="e.g. A9B2X1" 
                        maxlength="6" 
                        required
                        class="w-full bg-slate-950 border border-indigo-500/40 rounded-2xl px-4 py-3 text-sm text-center font-mono font-extrabold uppercase tracking-widest text-indigo-300 placeholder-slate-700 focus:outline-none focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 transition shadow-inner"
                    >
                </div>

                <button 
                    type="submit" 
                    class="w-full mt-2 bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white font-bold py-3.5 px-4 rounded-2xl shadow-lg shadow-emerald-600/25 transition-all duration-200 text-sm flex items-center justify-center gap-2 cursor-pointer active:scale-[0.99]">
                    Authenticate & Enter Exam Room →
                </button>
            </form>

            <div class="pt-6 border-t border-slate-800/80 text-center">
                <a href="/" class="text-xs text-slate-500 hover:text-slate-300 font-medium transition inline-flex items-center gap-1.5">
                    ← Return to Main Portal
                </a>
            </div>
        </div>

        <!-- Security Badge Note -->
        <p class="text-center text-[11px] text-slate-600 mt-6 font-medium">
            Proctored Session • IP and submission timestamps are recorded automatically
        </p>
    </div>

</body>
</html>