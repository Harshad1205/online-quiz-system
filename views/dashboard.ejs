<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Faculty Dashboard — Examination Management</title>
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Browser Tab Favicon (Circular Quiz Medallion) -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='48' fill='%230f172a' stroke='%2338bdf8' stroke-width='4'/%3E%3Cpolygon points='50,20 28,30 72,30' fill='%23f59e0b'/%3E%3Crect x='30' y='30' width='40' height='3' fill='%23f8fafc'/%3E%3Crect x='34' y='33' width='4' height='18' rx='1' fill='%23f8fafc'/%3E%3Crect x='44' y='33' width='4' height='18' rx='1' fill='%23f8fafc'/%3E%3Crect x='52' y='33' width='4' height='18' rx='1' fill='%23f8fafc'/%3E%3Crect x='62' y='33' width='4' height='18' rx='1' fill='%23f8fafc'/%3E%3Crect x='28' y='51' width='44' height='3' fill='%2394a3b8'/%3E%3Crect x='25' y='54' width='50' height='4' rx='1' fill='%23f8fafc'/%3E%3Crect x='28' y='64' width='12' height='12' rx='2' fill='%230284c7'/%3E%3Ctext x='34' y='73' font-size='9' font-weight='bold' fill='white' text-anchor='middle' font-family='sans-serif'%3EA%3C/text%3E%3Crect x='44' y='64' width='12' height='12' rx='2' fill='%236366f1'/%3E%3Ctext x='50' y='73' font-size='9' font-weight='bold' fill='white' text-anchor='middle' font-family='sans-serif'%3EB%3C/text%3E%3Crect x='60' y='64' width='12' height='12' rx='2' fill='%2310b981'/%3E%3Ctext x='66' y='73' font-size='9' font-weight='bold' fill='white' text-anchor='middle' font-family='sans-serif'%3EC%3C/text%3E%3C/svg%3E">

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen selection:bg-indigo-500 selection:text-white relative overflow-x-hidden antialiased">

    <!-- Ambient Background Glows -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-1/2 -right-32 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <% 
        const userGreeting = (typeof facultyName !== 'undefined' && facultyName) ? facultyName : 'Faculty Member';
        const quizItems = (typeof quizzes !== 'undefined' && Array.isArray(quizzes)) ? quizzes : [];
    %>

    <!-- Top Navigation Header -->
    <nav class="border-b border-slate-800/80 bg-slate-950/70 backdrop-blur-xl sticky top-0 z-50 transition">
        <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <a href="/" class="flex items-center gap-3 group transition">
                    <!-- Circular Medallion Emblem with Quiz ABC Elements -->
                    <div class="relative flex items-center justify-center flex-shrink-0">
                        <div class="absolute -inset-1 rounded-full bg-gradient-to-tr from-sky-400 via-indigo-500 to-amber-400 opacity-30 blur-[6px] group-hover:opacity-60 transition duration-300"></div>
                        <svg class="relative w-11 h-11 drop-shadow-xl group-hover:scale-105 transition-transform duration-200" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <linearGradient id="dashSilverRim" x1="0%" y1="0%" x2="100%" y2="100%">
                                    <stop offset="0%" stop-color="#f8fafc"/>
                                    <stop offset="25%" stop-color="#94a3b8"/>
                                    <stop offset="50%" stop-color="#cbd5e1"/>
                                    <stop offset="75%" stop-color="#64748b"/>
                                    <stop offset="100%" stop-color="#334155"/>
                                </linearGradient>
                                <linearGradient id="dashMedallionCore" x1="0%" y1="0%" x2="0%" y2="100%">
                                    <stop offset="0%" stop-color="#1e293b"/>
                                    <stop offset="100%" stop-color="#020617"/>
                                </linearGradient>
                                <linearGradient id="dashPillarGold" x1="0%" y1="0%" x2="100%" y2="0%">
                                    <stop offset="0%" stop-color="#fde68a"/>
                                    <stop offset="50%" stop-color="#f59e0b"/>
                                    <stop offset="100%" stop-color="#d97706"/>
                                </linearGradient>
                            </defs>

                            <!-- Outer Double Bevel Border -->
                            <circle cx="60" cy="60" r="57" fill="url(#dashSilverRim)" stroke="#475569" stroke-width="1.5"/>
                            <circle cx="60" cy="60" r="51" fill="none" stroke="#f1f5f9" stroke-width="1.5" stroke-opacity="0.8"/>
                            <circle cx="60" cy="60" r="48" fill="url(#dashMedallionCore)" stroke="#0ea5e9" stroke-width="1" stroke-dasharray="2 3"/>

                            <!-- Classical Academic Pillars -->
                            <polygon points="60,25 35,35 85,35" fill="url(#dashPillarGold)" />
                            <rect x="36" y="35" width="48" height="3" rx="0.5" fill="#f8fafc" />
                            <rect x="40" y="39" width="4" height="18" rx="1" fill="url(#dashPillarGold)" />
                            <rect x="50" y="39" width="4" height="18" rx="1" fill="url(#dashPillarGold)" />
                            <rect x="60" y="39" width="4" height="18" rx="1" fill="url(#dashPillarGold)" />
                            <rect x="70" y="39" width="4" height="18" rx="1" fill="url(#dashPillarGold)" />
                            <rect x="36" y="58" width="48" height="3" rx="0.5" fill="#94a3b8" />
                            <rect x="33" y="61.5" width="54" height="3" rx="0.8" fill="#f8fafc" />

                            <!-- Interactive ABC Options & Pencil -->
                            <rect x="34" y="69" width="10" height="9" rx="2" fill="#0284c7" stroke="#38bdf8" stroke-width="0.8"/>
                            <text x="39" y="76" font-size="7" font-weight="900" fill="#ffffff" text-anchor="middle" font-family="sans-serif">A</text>

                            <rect x="47" y="69" width="10" height="9" rx="2" fill="#4f46e5" stroke="#818cf8" stroke-width="0.8"/>
                            <text x="52" y="76" font-size="7" font-weight="900" fill="#ffffff" text-anchor="middle" font-family="sans-serif">B</text>

                            <rect x="60" y="69" width="10" height="9" rx="2" fill="#059669" stroke="#34d399" stroke-width="0.8"/>
                            <text x="65" y="76" font-size="7" font-weight="900" fill="#ffffff" text-anchor="middle" font-family="sans-serif">C</text>

                            <path d="M75 87 L87 75 L89 77 L77 89 Z" fill="#f59e0b" />
                            <polygon points="75,87 72,91 77,89" fill="#e2e8f0" stroke="#475569" stroke-width="0.5" />
                            <circle cx="72" cy="91" r="0.8" fill="#0f172a" />
                        </svg>
                    </div>

                    <!-- Typography -->
                    <div>
                        <span class="font-extrabold text-lg tracking-tight text-white block leading-none">EduAssessment</span>
                        <span class="text-[10px] text-slate-400 uppercase tracking-widest font-semibold block mt-0.5">Faculty Workspace</span>
                    </div>
                </a>
            </div>

            <div class="flex items-center gap-3">
                <a href="/faculty/create-quiz" 
                   class="bg-gradient-to-r from-indigo-600 to-sky-500 hover:from-indigo-500 hover:to-sky-400 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-lg shadow-indigo-600/25 transition-all duration-200 active:scale-95 flex items-center gap-1.5">
                    <span>+</span> Create Assessment
                </a>
                <a href="/faculty/logout" 
                   class="text-xs font-semibold text-rose-400 hover:text-rose-300 bg-rose-500/10 hover:bg-rose-500/20 border border-rose-500/20 px-3.5 py-2.5 rounded-xl transition">
                    Logout
                </a>
            </div>
        </div>
    </nav>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-6 py-10 relative z-10 space-y-8">
        
        <!-- Welcome Hero Strip -->
        <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 backdrop-blur-xl shadow-2xl flex flex-wrap items-center justify-between gap-6">
            <div>
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-[11px] font-bold uppercase tracking-wider mb-2">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    Faculty Terminal Verified
                </span>
                <h1 class="text-2xl md:text-3xl font-black text-white tracking-tight">
                    Welcome back, <%= userGreeting %> 👋
                </h1>
                <p class="text-slate-400 text-xs md:text-sm mt-1">
                    Authorized Academic Instructor • Assessment lifecycle and result telemetry control
                </p>
            </div>

            <div class="flex items-center gap-4 bg-slate-950/60 border border-slate-800 px-5 py-3 rounded-2xl">
                <div>
                    <span class="text-[10px] uppercase font-bold text-slate-500 tracking-wider block">Created Quizzes</span>
                    <span class="text-xl font-extrabold text-white font-mono"><%= quizItems.length %></span>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-between pt-2">
            <h2 class="text-sm font-extrabold uppercase tracking-widest text-slate-300 flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-indigo-500"></span> Active & Past Assessments
            </h2>
        </div>

        <!-- Empty State -->
        <% if (quizItems.length === 0) { %>
            <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-16 text-center shadow-xl space-y-4">
                <div class="w-14 h-14 rounded-2xl bg-slate-800 border border-slate-700 text-slate-400 flex items-center justify-center font-bold text-xl mx-auto">
                    📝
                </div>
                <h3 class="text-base font-bold text-white">No Quizzes Created Yet</h3>
                <p class="text-xs text-slate-400 max-w-sm mx-auto">You have not authored any assessments. Launch your first exam to get an instant PIN code.</p>
                <div class="pt-2">
                    <a href="/faculty/create-quiz" class="inline-flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold px-5 py-3 rounded-2xl shadow-lg shadow-indigo-600/20 transition">
                        + Create Your First Quiz
                    </a>
                </div>
            </div>
        <% } else { %>
            <!-- Quizzes Repository -->
            <div class="space-y-5">
                <% quizItems.forEach(quiz => { %>
                    <% 
                        const hasDeadline = Boolean(quiz && quiz.deadline);
                        const isExpired = hasDeadline && (new Date() > new Date(quiz.deadline));
                        const qCount = (quiz && Array.isArray(quiz.questions)) ? quiz.questions.length : 0;
                    %>
                    <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-6 md:p-8 shadow-xl transition-all duration-200 hover:border-slate-700 space-y-6 relative overflow-hidden">
                        
                        <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-slate-800/80">
                            <div class="flex items-center gap-3">
                                <span class="px-2.5 py-1 rounded-lg bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-bold uppercase tracking-wider">
                                    <%= (quiz && quiz.subject) ? quiz.subject : 'General' %>
                                </span>
                                <h3 class="text-lg md:text-xl font-bold text-white">
                                    <%= (quiz && quiz.title) ? quiz.title : 'Untitled Quiz' %>
                                </h3>
                            </div>

                            <div>
                                <% if (!hasDeadline) { %>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-800 border border-slate-700 text-slate-300 text-xs font-bold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> Open Access (No Deadline)
                                    </span>
                                <% } else if (isExpired) { %>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-bold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Expired
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-bold">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> Active & Accepting Submissions
                                    </span>
                                <% } %>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs">
                            <div class="bg-slate-950/70 border border-slate-800/80 rounded-2xl p-4">
                                <span class="text-[10px] font-bold uppercase tracking-widest text-slate-500 block mb-1">Session PIN Code</span>
                                <span class="font-mono font-extrabold text-sm text-indigo-400 tracking-wider"><%= (quiz && quiz.quizCode) ? quiz.quizCode : '------' %></span>
                            </div>

                            <div class="bg-slate-950/70 border border-slate-800/80 rounded-2xl p-4">
                                <span class="text-[10px] font-bold uppercase tracking-widest text-slate-500 block mb-1">Duration</span>
                                <span class="font-bold text-slate-200 text-sm"><%= (quiz && quiz.duration) ? quiz.duration : 10 %> Minutes</span>
                            </div>

                            <div class="bg-slate-950/70 border border-slate-800/80 rounded-2xl p-4">
                                <span class="text-[10px] font-bold uppercase tracking-widest text-slate-500 block mb-1">Questions</span>
                                <span class="font-bold text-slate-200 text-sm"><%= qCount %> Items</span>
                            </div>

                            <div class="bg-slate-950/70 border border-slate-800/80 rounded-2xl p-4">
                                <span class="text-[10px] font-bold uppercase tracking-widest text-slate-500 block mb-1">Deadline</span>
                                <span class="font-semibold text-slate-300 text-xs">
                                    <%= hasDeadline ? new Date(quiz.deadline).toLocaleString() : 'Open / Unset' %>
                                </span>
                            </div>
                        </div>

                        <div class="pt-2 flex flex-wrap items-center justify-between gap-3 border-t border-slate-800/80">
                            <div class="flex items-center gap-2.5 flex-wrap">
                                <a href="/faculty/quiz-results/<%= quiz._id %>" 
                                   class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-lg shadow-indigo-600/20 transition active:scale-95 inline-flex items-center gap-1.5">
                                    📊 View Submissions & Choices
                                </a>
                                <a href="/faculty/export-results/<%= quiz._id %>" 
                                   class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-lg shadow-emerald-600/20 transition active:scale-95 inline-flex items-center gap-1.5">
                                    📥 Export Excel
                                </a>
                                <a href="/faculty/edit-quiz/<%= quiz._id %>" 
                                   class="bg-slate-800 hover:bg-slate-750 text-slate-200 border border-slate-700/80 text-xs font-bold px-3.5 py-2.5 rounded-xl transition">
                                    ✏️ Edit
                                </a>
                            </div>

                            <form action="/faculty/delete-quiz/<%= quiz._id %>" method="POST" class="m-0" onsubmit="return confirm('Are you sure you want to permanently delete this assessment along with all its submitted student records?');">
                                <button type="submit" 
                                        class="bg-rose-950/30 hover:bg-rose-900/50 text-rose-400 border border-rose-800/40 text-xs font-bold px-3.5 py-2.5 rounded-xl transition active:scale-95">
                                    🗑️ Delete Assessment
                                </button>
                            </form>
                        </div>

                    </div>
                <% }) %>
            </div>
        <% } %>

    </main>

    <!-- Unified Clean Footer -->
    <footer class="border-t border-slate-800/80 bg-slate-950 py-8 text-center text-xs text-slate-500 relative z-10 space-y-1">
        <p>© 2026 EduAssessment Examination & Quiz Cloud. All Rights Reserved.</p>
        <p class="text-[11px] text-slate-600">Engineered for academic rigor, verifiable audit trails, and automated evaluation metrics.</p>
    </footer>

</body>
</html>