<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Submissions & Analytics — <%= quiz.title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen py-6 md:py-10 px-4 md:px-8 selection:bg-indigo-500 selection:text-white">

    <div class="max-w-6xl mx-auto space-y-6">
        
        <!-- Header Panel -->
        <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 backdrop-blur-xl shadow-2xl flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div>
                <a href="/faculty/dashboard" class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-400 hover:text-indigo-300 transition mb-2">
                    ← Back to Dashboard
                </a>
                <h1 class="text-2xl md:text-3xl font-black text-white tracking-tight"><%= quiz.title %></h1>
                <div class="flex flex-wrap items-center gap-2 mt-2 text-xs">
                    <span class="px-2.5 py-1 rounded-lg bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 font-bold uppercase tracking-wider">
                        <%= quiz.subject %>
                    </span>
                    <span class="text-slate-400">
                        PIN: <strong class="text-emerald-400 font-mono"><%= quiz.quizCode %></strong>
                    </span>
                    <span class="text-slate-600">•</span>
                    <span class="text-slate-400">
                        Submissions: <strong class="text-white font-bold"><%= results.length %></strong>
                    </span>
                </div>
            </div>

            <div>
                <a href="/faculty/export-results/<%= quiz._id %>" 
                   class="w-full md:w-auto inline-flex items-center justify-center gap-2 bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white text-xs font-bold px-5 py-3 rounded-2xl shadow-lg shadow-emerald-600/20 transition active:scale-95">
                    📊 Export Excel (.xlsx)
                </a>
            </div>
        </div>

        <% if (results.length === 0) { %>
            <div class="bg-slate-900/80 border border-slate-800 rounded-3xl py-16 px-6 text-center">
                <div class="w-14 h-14 rounded-2xl bg-slate-800 border border-slate-700 text-slate-400 flex items-center justify-center text-2xl mx-auto mb-3">📋</div>
                <h3 class="text-base font-bold text-white mb-1">No Student Submissions Recorded</h3>
                <p class="text-xs text-slate-500">Student attempts will appear here immediately once completed.</p>
            </div>
        <% } else { %>

            <!-- Mobile View: Clean Interactive Submission Cards -->
            <div class="space-y-4 md:hidden">
                <% results.forEach((r) => { 
                    const pct = Math.round((r.score / r.totalQuestions) * 100);
                %>
                    <div class="bg-slate-900/90 border border-slate-800 rounded-2xl p-5 space-y-3 shadow-lg">
                        <div class="flex justify-between items-start">
                            <div>
                                <h3 class="font-bold text-white text-sm"><%= r.studentName %></h3>
                                <p class="text-xs text-slate-400 font-mono"><%= r.studentEmail %></p>
                            </div>
                            <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-bold <%= pct >= 50 ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-400 border border-rose-500/20' %>">
                                <%= pct %>%
                            </span>
                        </div>

                        <div class="flex justify-between items-center text-xs text-slate-400 border-t border-b border-slate-800/80 py-2.5">
                            <span>Score: <strong class="text-indigo-400 font-bold font-mono"><%= r.score %> / <%= r.totalQuestions %></strong></span>
                            <span class="text-[11px]"><%= new Date(r.submittedAt).toLocaleDateString() %></span>
                        </div>

                        <button onclick="toggleDetails('m-<%= r._id %>')" 
                                class="w-full bg-slate-800 hover:bg-slate-750 text-slate-200 border border-slate-700 text-xs font-bold py-2.5 rounded-xl transition">
                            Inspect Chosen Answers ▾
                        </button>

                        <div id="tray-m-<%= r._id %>" class="hidden pt-3 space-y-3">
                            <% if (!r.answers || r.answers.length === 0) { %>
                                <p class="text-xs text-slate-500 italic">No telemetry recorded for this attempt.</p>
                            <% } else { %>
                                <% r.answers.forEach((ans, qNum) => { %>
                                    <div class="rounded-xl p-3 border text-xs <%= ans.isCorrect ? 'bg-emerald-950/20 border-emerald-500/30' : 'bg-rose-950/20 border-rose-500/30' %>">
                                        <p class="font-bold text-slate-200 mb-1">Q<%= qNum + 1 %>: <%= ans.questionText %></p>
                                        <% if (ans.selectedOption !== null && ans.selectedOption !== undefined) { %>
                                            <p class="text-slate-300">Selected: <strong class="text-white">Option <%= String.fromCharCode(65 + ans.selectedOption) %> (<%= ans.options[ans.selectedOption] %>)</strong></p>
                                            <span class="text-[11px] font-bold <%= ans.isCorrect ? 'text-emerald-400' : 'text-rose-400' %>">
                                                <%= ans.isCorrect ? '✔ Correct' : '✖ Wrong' %>
                                            </span>
                                        <% } else { %>
                                            <p class="text-amber-400 font-semibold">⚠️ Question Skipped</p>
                                        <% } %>
                                        <% if (!ans.isCorrect) { %>
                                            <p class="text-slate-400 mt-1">Correct: <strong class="text-indigo-300">Option <%= String.fromCharCode(65 + ans.correctOption) %> (<%= ans.options[ans.correctOption] %>)</strong></p>
                                        <% } %>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>

            <!-- Desktop View: High-Performance Data Table -->
            <div class="hidden md:block bg-slate-900/80 border border-slate-800 rounded-3xl overflow-hidden shadow-2xl">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-950/70 text-slate-400 border-b border-slate-800 uppercase tracking-wider font-extrabold text-[11px]">
                        <tr>
                            <th class="py-4 px-6">Candidate</th>
                            <th class="py-4 px-6">Institutional Email</th>
                            <th class="py-4 px-6">Marks</th>
                            <th class="py-4 px-6">Grade %</th>
                            <th class="py-4 px-6">Submitted At</th>
                            <th class="py-4 px-6 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60">
                        <% results.forEach((r) => { 
                            const pct = Math.round((r.score / r.totalQuestions) * 100);
                        %>
                            <tr class="hover:bg-slate-850/50 transition">
                                <td class="py-4 px-6 font-bold text-slate-100 text-sm"><%= r.studentName %></td>
                                <td class="py-4 px-6 text-slate-400 font-mono text-xs"><%= r.studentEmail %></td>
                                <td class="py-4 px-6 font-mono font-extrabold text-sm text-indigo-400">
                                    <%= r.score %> <span class="text-slate-600 font-normal">/</span> <%= r.totalQuestions %>
                                </td>
                                <td class="py-4 px-6">
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-[11px] font-bold border <%= pct >= 50 ? 'bg-emerald-500/10 border-emerald-500/20 text-emerald-400' : 'bg-rose-500/10 border-rose-500/20 text-rose-400' %>">
                                        <%= pct %>%
                                    </span>
                                </td>
                                <td class="py-4 px-6 text-slate-400"><%= new Date(r.submittedAt).toLocaleString() %></td>
                                <td class="py-4 px-6 text-right">
                                    <button onclick="toggleDetails('<%= r._id %>')" 
                                            class="bg-slate-800 hover:bg-slate-750 text-slate-200 border border-slate-700/80 px-3.5 py-2 rounded-xl text-xs font-bold transition active:scale-95">
                                        Inspect Choices ▾
                                    </button>
                                </td>
                            </tr>

                            <!-- Collapsible Drawer (Desktop) -->
                            <tr id="tray-<%= r._id %>" class="hidden bg-slate-950/90 border-t border-b border-indigo-500/20">
                                <td colspan="6" class="p-6">
                                    <div class="grid grid-cols-2 gap-4">
                                        <% if (!r.answers || r.answers.length === 0) { %>
                                            <p class="text-xs text-slate-500 italic col-span-2">No itemized choices recorded.</p>
                                        <% } else { %>
                                            <% r.answers.forEach((ans, qNum) => { %>
                                                <div class="rounded-2xl p-4 border text-xs <%= ans.isCorrect ? 'bg-emerald-950/20 border-emerald-500/30' : 'bg-rose-950/20 border-rose-500/30' %> space-y-1.5">
                                                    <div class="flex justify-between items-start gap-2">
                                                        <strong class="text-slate-200 text-sm">Q<%= qNum + 1 %>: <%= ans.questionText %></strong>
                                                        <span class="text-[10px] font-bold px-2 py-0.5 rounded <%= ans.isCorrect ? 'bg-emerald-500/20 text-emerald-300' : 'bg-rose-500/20 text-rose-300' %>">
                                                            <%= ans.isCorrect ? '✔ Correct' : '✖ Wrong' %>
                                                        </span>
                                                    </div>
                                                    <% if (ans.selectedOption !== null && ans.selectedOption !== undefined) { %>
                                                        <p class="text-slate-300">Selected: <strong class="text-white">Option <%= String.fromCharCode(65 + ans.selectedOption) %> (<%= ans.options[ans.selectedOption] %>)</strong></p>
                                                    <% } else { %>
                                                        <p class="text-amber-400 font-semibold">⚠️ Question Skipped</p>
                                                    <% } %>
                                                    <% if (!ans.isCorrect) { %>
                                                        <p class="text-slate-400">Correct: <strong class="text-indigo-300">Option <%= String.fromCharCode(65 + ans.correctOption) %> (<%= ans.options[ans.correctOption] %>)</strong></p>
                                                    <% } %>
                                                </div>
                                            <% }) %>
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

        <% } %>

    </div>

    <script>
        function toggleDetails(id) {
            const tray = document.getElementById('tray-' + id);
            if (tray) {
                tray.classList.toggle('hidden');
            }
        }
    </script>
</body>
</html>