<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Assessment — <%= quiz.title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        /* Custom date picker icon color for dark mode */
        input[type="datetime-local"]::-webkit-calendar-picker-indicator {
            filter: invert(1);
            cursor: pointer;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen py-10 px-4 md:px-8 selection:bg-indigo-500 selection:text-white">
    <div class="max-w-4xl mx-auto space-y-8">
        
        <!-- Header Toolbar -->
        <div class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 backdrop-blur-xl shadow-2xl flex flex-wrap items-center justify-between gap-4">
            <div>
                <a href="/faculty/dashboard" class="inline-flex items-center gap-1 text-xs font-semibold text-indigo-400 hover:text-indigo-300 transition mb-1">
                    ← Back to Dashboard
                </a>
                <h1 class="text-2xl font-black tracking-tight text-white">Assessment Editor</h1>
                <p class="text-xs text-slate-400">Modify assessment metadata, update options, and reset answer keys.</p>
            </div>
            <div class="flex items-center gap-3">
                <div class="text-right">
                    <span class="text-[10px] uppercase font-bold text-slate-500 tracking-wider block">Access Key</span>
                    <span class="font-mono font-extrabold text-sm text-emerald-400 bg-emerald-950/40 border border-emerald-500/30 px-3 py-1 rounded-xl inline-block">
                        <%= quiz.quizCode %>
                    </span>
                </div>
            </div>
        </div>

        <form action="/faculty/edit-quiz/<%= quiz._id %>" method="POST" class="space-y-8">
            
            <!-- Assessment Metadata Card -->
            <div class="bg-slate-900/80 border border-slate-800 rounded-3xl p-6 md:p-8 shadow-xl space-y-6">
                <div class="flex items-center gap-2 border-b border-slate-800 pb-4">
                    <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
                    <h2 class="text-xs font-extrabold uppercase tracking-widest text-slate-300">Exam Parameters</h2>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Quiz Title</label>
                        <input type="text" name="title" value="<%= quiz.title %>" required
                            class="w-full bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition shadow-inner">
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Course / Subject</label>
                        <input type="text" name="subject" value="<%= quiz.subject %>" required
                            class="w-full bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition shadow-inner">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-2">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Timer Duration (Minutes)</label>
                        <div class="relative">
                            <input type="number" name="duration" value="<%= quiz.duration || 10 %>" min="1" required
                                class="w-full bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-sm text-slate-100 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition shadow-inner">
                            <span class="absolute right-4 top-3.5 text-xs font-bold text-slate-500 pointer-events-none">MINS</span>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Submission Deadline</label>
                        <div class="flex gap-2">
                            <input 
                                type="datetime-local" 
                                id="deadline" 
                                name="deadline" 
                                value="<%= quiz.deadline ? new Date(quiz.deadline.getTime() - (quiz.deadline.getTimezoneOffset() * 60000)).toISOString().slice(0, 16) : '' %>"
                                class="w-full bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-sm text-slate-100 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition shadow-inner"
                            >
                            <button type="button" id="confirmDateBtn" onclick="confirmSelectedDate()"
                                class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs px-4 rounded-2xl transition whitespace-nowrap shadow-lg shadow-indigo-600/20">
                                Verify
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Deadline Presets & Feedback -->
                <div class="pt-2 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-1.5 flex-wrap">
                        <span class="text-[11px] font-bold text-slate-500 uppercase mr-1">Quick Presets:</span>
                        <button type="button" onclick="setPresetHours(6)" class="bg-slate-950 hover:bg-slate-850 text-slate-300 border border-slate-800 hover:border-slate-700 text-[11px] font-medium px-2.5 py-1 rounded-lg transition">+6 Hours</button>
                        <button type="button" onclick="setPresetDays(1)" class="bg-slate-950 hover:bg-slate-850 text-slate-300 border border-slate-800 hover:border-slate-700 text-[11px] font-medium px-2.5 py-1 rounded-lg transition">Tomorrow</button>
                        <button type="button" onclick="setPresetDays(2)" class="bg-slate-950 hover:bg-slate-850 text-slate-300 border border-slate-800 hover:border-slate-700 text-[11px] font-medium px-2.5 py-1 rounded-lg transition">In 2 Days</button>
                        <button type="button" onclick="setPresetDays(7)" class="bg-slate-950 hover:bg-slate-850 text-slate-300 border border-slate-800 hover:border-slate-700 text-[11px] font-medium px-2.5 py-1 rounded-lg transition">In 1 Week</button>
                    </div>
                    <span id="dateStatus" class="text-xs font-bold text-emerald-400 hidden"></span>
                </div>
            </div>

            <!-- Question Builder Queue Header -->
            <div class="flex items-center justify-between pt-2">
                <div class="flex items-center gap-2">
                    <span class="h-6 w-6 rounded-lg bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 flex items-center justify-center font-black text-xs">#</span>
                    <h3 class="text-base font-bold text-white">Questions Repository</h3>
                </div>
                <button type="button" onclick="addQuestion()" 
                    class="bg-slate-900 hover:bg-slate-800 text-indigo-400 border border-indigo-500/30 text-xs font-bold px-3.5 py-2 rounded-xl transition flex items-center gap-1.5 shadow-sm">
                    <span>+</span> Add Question Card
                </button>
            </div>

            <!-- Dynamic Questions Container -->
            <div id="questions-container" class="space-y-6">
                <% quiz.questions.forEach((question, qIndex) => { %>
                    <div class="question-card bg-slate-900/80 border border-slate-800 rounded-3xl p-6 md:p-8 shadow-xl space-y-6 transition hover:border-slate-700/80">
                        <div class="flex items-center justify-between pb-3 border-b border-slate-800">
                            <span class="question-label inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-widest text-indigo-400">
                                <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span> Question <%= qIndex + 1 %>
                            </span>
                            <% if (quiz.questions.length > 1) { %>
                                <button type="button" onclick="this.closest('.question-card').remove(); renumberQuestions();" 
                                    class="text-xs text-rose-400 hover:text-rose-300 font-semibold px-2 py-1 rounded-lg hover:bg-rose-950/30 transition">
                                    Remove Question
                                </button>
                            <% } %>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Question Statement</label>
                            <input type="text" name="question" value="<%= question.question %>" required placeholder="Enter the question premise..."
                                class="w-full bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition shadow-inner">
                        </div>

                        <div class="space-y-3">
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400">Answer Options & Correct Choice</label>
                            
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                                <!-- Option A -->
                                <div class="flex items-center bg-slate-950 border border-slate-800 rounded-2xl p-2 focus-within:border-indigo-500/70 transition">
                                    <span class="h-8 w-8 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 flex items-center justify-center font-bold text-xs shrink-0 ml-1">A</span>
                                    <input type="text" name="option1" value="<%= question.options[0] %>" required placeholder="Option 1 statement"
                                        class="w-full bg-transparent px-3 py-1.5 text-xs text-slate-200 placeholder-slate-600 focus:outline-none">
                                </div>

                                <!-- Option B -->
                                <div class="flex items-center bg-slate-950 border border-slate-800 rounded-2xl p-2 focus-within:border-indigo-500/70 transition">
                                    <span class="h-8 w-8 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 flex items-center justify-center font-bold text-xs shrink-0 ml-1">B</span>
                                    <input type="text" name="option2" value="<%= question.options[1] %>" required placeholder="Option 2 statement"
                                        class="w-full bg-transparent px-3 py-1.5 text-xs text-slate-200 placeholder-slate-600 focus:outline-none">
                                </div>

                                <!-- Option C -->
                                <div class="flex items-center bg-slate-950 border border-slate-800 rounded-2xl p-2 focus-within:border-indigo-500/70 transition">
                                    <span class="h-8 w-8 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 flex items-center justify-center font-bold text-xs shrink-0 ml-1">C</span>
                                    <input type="text" name="option3" value="<%= question.options[2] %>" required placeholder="Option 3 statement"
                                        class="w-full bg-transparent px-3 py-1.5 text-xs text-slate-200 placeholder-slate-600 focus:outline-none">
                                </div>

                                <!-- Option D -->
                                <div class="flex items-center bg-slate-950 border border-slate-800 rounded-2xl p-2 focus-within:border-indigo-500/70 transition">
                                    <span class="h-8 w-8 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 flex items-center justify-center font-bold text-xs shrink-0 ml-1">D</span>
                                    <input type="text" name="option4" value="<%= question.options[3] %>" required placeholder="Option 4 statement"
                                        class="w-full bg-transparent px-3 py-1.5 text-xs text-slate-200 placeholder-slate-600 focus:outline-none">
                                </div>
                            </div>
                        </div>

                        <!-- Answer Key Selection Pill -->
                        <div class="pt-2">
                            <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">Official Answer Key</label>
                            <div class="relative w-full sm:w-64">
                                <select name="correctAnswer" required
                                    class="w-full bg-slate-950 border border-slate-800 text-emerald-400 font-bold text-xs rounded-xl px-4 py-2.5 appearance-none focus:outline-none focus:border-emerald-500 transition cursor-pointer">
                                    <option value="0" <%= question.correctAnswer === 0 ? 'selected' : '' %>>Option A is Correct</option>
                                    <option value="1" <%= question.correctAnswer === 1 ? 'selected' : '' %>>Option B is Correct</option>
                                    <option value="2" <%= question.correctAnswer === 2 ? 'selected' : '' %>>Option C is Correct</option>
                                    <option value="3" <%= question.correctAnswer === 3 ? 'selected' : '' %>>Option D is Correct</option>
                                </select>
                                <span class="absolute right-3.5 top-2.5 text-xs text-slate-500 pointer-events-none">▼</span>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>

            <!-- Action Controls -->
            <div class="pt-4 flex flex-col sm:flex-row gap-4">
                <button type="submit" 
                    class="w-full sm:w-2/3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-4 px-6 rounded-2xl shadow-lg shadow-emerald-600/25 transition text-sm flex items-center justify-center gap-2">
                    ✓ Save & Synchronize Assessment
                </button>
                <a href="/faculty/dashboard" 
                    class="w-full sm:w-1/3 bg-slate-900 hover:bg-slate-800 text-slate-400 hover:text-slate-200 border border-slate-800 font-bold py-4 px-6 rounded-2xl transition text-sm text-center">
                    Discard Changes
                </a>
            </div>
        </form>
    </div>

    <!-- Client-Side Engine for Presets, Renumbering & Dynamic Insertions -->
    <script>
        function formatDateForInput(date) {
            const offset = date.getTimezoneOffset() * 60000;
            return new Date(date.getTime() - offset).toISOString().slice(0, 16);
        }

        function setPresetHours(hours) {
            const d = new Date();
            d.setHours(d.getHours() + hours);
            document.getElementById('deadline').value = formatDateForInput(d);
            confirmSelectedDate();
        }

        function setPresetDays(days) {
            const d = new Date();
            d.setDate(d.getDate() + days);
            document.getElementById('deadline').value = formatDateForInput(d);
            confirmSelectedDate();
        }

        function confirmSelectedDate() {
            const input = document.getElementById('deadline');
            const status = document.getElementById('dateStatus');
            const btn = document.getElementById('confirmDateBtn');
            
            if (input.value) {
                const selected = new Date(input.value);
                status.textContent = `✓ Due: ${selected.toLocaleString()}`;
                status.classList.remove('hidden');
                btn.textContent = '✓ Verified';
                btn.classList.replace('bg-indigo-600', 'bg-emerald-600');

                setTimeout(() => {
                    btn.textContent = 'Verify';
                    btn.classList.replace('bg-emerald-600', 'bg-indigo-600');
                }, 2000);
            } else {
                alert('Please select a date from the calendar input first.');
            }
        }

        function addQuestion() {
            const container = document.getElementById('questions-container');
            const index = container.querySelectorAll('.question-card').length + 1;
            const card = document.createElement('div');
            card.className = 'question-card bg-slate-900/80 border border-slate-800 rounded-3xl p-6 md:p-8 shadow-xl space-y-6 transition hover:border-slate-700/80';
            
            card.innerHTML = `
                <div class="flex items-center justify-between pb-3 border-b border-slate-800">
                    <span class="question-label inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-widest text-indigo-400">
                        <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span> Question ${index}
                    </span>
                    <button type="button" onclick="this.closest('.question-card').remove(); renumberQuestions();" 
                        class="text-xs text-rose-400 hover:text-rose-300 font-semibold px-2 py-1 rounded-lg hover:bg-rose-950/30 transition">
                        Remove Question
                    </button>
                </div>

                <div>
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Question Statement</label>
                    <input type="text" name="question" required placeholder="Enter the question premise..."
                        class="w-full bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition shadow-inner">
                </div>

                <div class="space-y-3">
                    <label class="block text-xs font-bold uppercase tracking-wider text-slate-400">Answer Options & Correct Choice</label>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div class="flex items-center bg-slate-950 border border-slate-800 rounded-2xl p-2 focus-within:border-indigo-500/70 transition">
                            <span class="h-8 w-8 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 flex items-center justify-center font-bold text-xs shrink-0 ml-1">A</span>
                            <input type="text" name="option1" required placeholder="Option 1 statement" class="w-full bg-transparent px-3 py-1.5 text-xs text-slate-200 placeholder-slate-600 focus:outline-none">
                        </div>
                        <div class="flex items-center bg-slate-950 border border-slate-800 rounded-2xl p-2 focus-within:border-indigo-500/70 transition">
                            <span class="h-8 w-8 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 flex items-center justify-center font-bold text-xs shrink-0 ml-1">B</span>
                            <input type="text" name="option2" required placeholder="Option 2 statement" class="w-full bg-transparent px-3 py-1.5 text-xs text-slate-200 placeholder-slate-600 focus:outline-none">
                        </div>
                        <div class="flex items-center bg-slate-950 border border-slate-800 rounded-2xl p-2 focus-within:border-indigo-500/70 transition">
                            <span class="h-8 w-8 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 flex items-center justify-center font-bold text-xs shrink-0 ml-1">C</span>
                            <input type="text" name="option3" required placeholder="Option 3 statement" class="w-full bg-transparent px-3 py-1.5 text-xs text-slate-200 placeholder-slate-600 focus:outline-none">
                        </div>
                        <div class="flex items-center bg-slate-950 border border-slate-800 rounded-2xl p-2 focus-within:border-indigo-500/70 transition">
                            <span class="h-8 w-8 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 flex items-center justify-center font-bold text-xs shrink-0 ml-1">D</span>
                            <input type="text" name="option4" required placeholder="Option 4 statement" class="w-full bg-transparent px-3 py-1.5 text-xs text-slate-200 placeholder-slate-600 focus:outline-none">
                        </div>
                    </div>
                </div>

                <div class="pt-2">
                    <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-1.5">Official Answer Key</label>
                    <div class="relative w-full sm:w-64">
                        <select name="correctAnswer" required class="w-full bg-slate-950 border border-slate-800 text-emerald-400 font-bold text-xs rounded-xl px-4 py-2.5 appearance-none focus:outline-none focus:border-emerald-500 transition cursor-pointer">
                            <option value="0">Option A is Correct</option>
                            <option value="1">Option B is Correct</option>
                            <option value="2">Option C is Correct</option>
                            <option value="3">Option D is Correct</option>
                        </select>
                        <span class="absolute right-3.5 top-2.5 text-xs text-slate-500 pointer-events-none">▼</span>
                    </div>
                </div>
            `;
            container.appendChild(card);
        }

        function renumberQuestions() {
            document.querySelectorAll('.question-card').forEach((card, idx) => {
                const label = card.querySelector('.question-label');
                if (label) {
                    label.innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span> Question ${idx + 1}`;
                }
            });
        }
    </script>
</body>
</html>