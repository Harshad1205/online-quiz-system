<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assessment Results - <%= quiz.title %></title>
    <link rel="stylesheet" href="/style.css">
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f8fafc; color: #1e293b; margin: 0; padding: 24px; }
        .container { max-width: 1100px; margin: auto; background: #fff; padding: 32px; border-radius: 12px; border: 1px solid #e2e8f0; box-shadow: 0 4px 6px rgba(0,0,0,0.02); }
        .top-bar { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #f1f5f9; padding-bottom: 20px; margin-bottom: 24px; flex-wrap: wrap; gap: 16px; }
        .quiz-title { font-size: 24px; font-weight: 800; color: #0f172a; margin: 0 0 6px 0; }
        .quiz-meta { font-size: 14px; color: #64748b; }
        .btn-group { display: flex; gap: 10px; align-items: center; }
        .btn-export { background-color: #16a34a; color: white; padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 14px; display: inline-flex; align-items: center; gap: 8px; transition: background 0.15s; }
        .btn-export:hover { background-color: #15803d; }
        .btn-back { background: #f1f5f9; color: #334155; padding: 10px 16px; border-radius: 8px; text-decoration: none; font-size: 14px; font-weight: 600; }
        .btn-back:hover { background: #e2e8f0; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 16px; }
        th, td { border: 1px solid #e2e8f0; padding: 12px 16px; text-align: left; font-size: 14px; }
        th { background: #f8fafc; color: #475569; font-weight: 700; }
        tr:hover { background-color: #f8fafc; }
        .badge { padding: 4px 10px; border-radius: 9999px; font-size: 12px; font-weight: 700; }
        .badge-normal { background: #dcfce7; color: #15803d; }
        .badge-late { background: #fee2e2; color: #b91c1c; }
    </style>
</head>
<body>

<div class="container">
    <div class="top-bar">
        <div>
            <h1 class="quiz-title"><%= quiz.title %></h1>
            <div class="quiz-meta">
                Subject: <strong><%= quiz.subject %></strong> | 
                Quiz Code: <strong><%= quiz.quizCode %></strong> | 
                Total Questions: <strong><%= quiz.questions.length %></strong> | 
                Submissions Recorded: <strong><%= results.length %></strong>
            </div>
        </div>
        <div class="btn-group">
            <a href="/faculty/dashboard" class="btn-back">← Back to Dashboard</a>
            <% if (results.length > 0) { %>
                <a href="/faculty/export-results/<%= quiz._id %>" class="btn-export">
                    📥 Export Excel Database (.xlsx)
                </a>
            <% } %>
        </div>
    </div>

    <% if (results.length === 0) { %>
        <div style="text-align: center; padding: 50px 20px; color: #64748b;">
            <p style="font-size: 16px;">No student submissions have been recorded for this assessment yet.</p>
        </div>
    <% } else { %>
        <table>
            <thead>
                <tr>
                    <th style="width: 60px;">Sr.</th>
                    <th>Student Name</th>
                    <th>Student Email</th>
                    <th>Score</th>
                    <th>Percentage</th>
                    <th>Submission Status</th>
                    <th>Timestamp</th>
                </tr>
            </thead>
            <tbody>
                <% results.forEach((r, idx) => { %>
                    <% 
                        const total = quiz.questions.length || 1;
                        const pct = ((r.score / total) * 100).toFixed(1);
                        const isLate = r.submissionReason && r.submissionReason.includes('Late');
                    %>
                    <tr>
                        <td><%= idx + 1 %></td>
                        <td><strong><%= r.studentName %></strong></td>
                        <td><%= r.studentEmail %></td>
                        <td><%= r.score %> / <%= total %></td>
                        <td><strong><%= pct %>%</strong></td>
                        <td>
                            <span class="badge <%= isLate ? 'badge-late' : 'badge-normal' %>">
                                <%= r.submissionReason || 'Normal Submission' %>
                            </span>
                        </td>
                        <td><%= r.submittedAt ? new Date(r.submittedAt).toLocaleString() : 'N/A' %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</div>

</body>
</html>