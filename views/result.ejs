<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quiz Result - <%= quiz.title %></title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
            margin: 0;
            padding: 30px 15px;
        }
        .container {
            max-width: 800px;
            margin: auto;
        }
        .score-card {
            background: #1e293b;
            padding: 30px;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
            margin-bottom: 25px;
            border: 1px solid #334155;
        }
        .score-box {
            font-size: 42px;
            font-weight: bold;
            color: #38bdf8;
            margin: 15px 0;
        }
        .breakdown-card {
            background: #1e293b;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
            border: 1px solid #334155;
        }
        .question-block {
            border: 1px solid #334155;
            background-color: #0f172a;
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 18px;
        }
        .question-block.correct {
            border-left: 6px solid #22c55e;
        }
        .question-block.incorrect {
            border-left: 6px solid #ef4444;
        }
        .option-item {
            padding: 10px 14px;
            margin: 6px 0;
            border-radius: 6px;
            font-size: 14px;
            background-color: #1e293b;
            border: 1px solid #334155;
            color: #cbd5e1;
        }
        .option-item.selected-correct {
            background-color: rgba(34, 197, 94, 0.15);
            border-color: #22c55e;
            color: #4ade80;
            font-weight: bold;
        }
        .option-item.selected-wrong {
            background-color: rgba(239, 68, 68, 0.15);
            border-color: #ef4444;
            color: #f87171;
            font-weight: bold;
        }
        .option-item.actual-correct {
            background-color: rgba(56, 189, 248, 0.15);
            border-color: #38bdf8;
            color: #38bdf8;
            font-weight: bold;
        }
        .badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: bold;
            float: right;
        }
        .badge.pass { background: rgba(34, 197, 94, 0.2); color: #4ade80; }
        .badge.fail { background: rgba(239, 68, 68, 0.2); color: #f87171; }
        .btn-home {
            display: inline-block;
            margin-top: 15px;
            background: #0284c7;
            color: #ffffff;
            text-decoration: none;
            padding: 10px 22px;
            border-radius: 6px;
            font-weight: bold;
        }
        .btn-home:hover { background: #0369a1; }
    </style>
</head>
<body>

<div class="container">
    <div class="score-card">
        <h2 style="margin-top: 0;">Exam Results</h2>
        <p style="color: #94a3b8; margin: 0;">Student: <strong><%= studentName %></strong> (<%= studentEmail %>)</p>
        <p style="color: #94a3b8; margin-top: 5px;">Quiz: <strong><%= quiz.title %></strong> | Subject: <%= quiz.subject %></p>
        
        <div class="score-box">
            <%= result.score %> / <%= result.totalQuestions %>
        </div>
        <p style="font-size: 15px; color: #94a3b8; margin: 0;">
            Score Percentage: <strong><%= Math.round((result.score / result.totalQuestions) * 100) %>%</strong>
        </p>

        <a href="/" class="btn-home">Return to Home</a>
    </div>

    <div class="breakdown-card">
        <h3 style="margin-top: 0; border-bottom: 1px solid #334155; padding-bottom: 12px;">
            Detailed Question Breakdown
        </h3>

        <% result.answers.forEach((ans, idx) => { %>
            <div class="question-block <%= ans.isCorrect ? 'correct' : 'incorrect' %>">
                <div>
                    <span class="badge <%= ans.isCorrect ? 'pass' : 'fail' %>">
                        <%= ans.isCorrect ? 'Correct (+1)' : 'Incorrect (0)' %>
                    </span>
                    <strong>Q<%= idx + 1 %>: <%= ans.questionText %></strong>
                </div>

                <div style="margin-top: 12px;">
                    <% ans.options.forEach((optText, optIdx) => { 
                        let optionClass = 'option-item';
                        let labelNote = '';

                        if (ans.selectedOption === optIdx) {
                            if (ans.isCorrect) {
                                optionClass += ' selected-correct';
                                labelNote = ' — Your Selection (Correct)';
                            } else {
                                optionClass += ' selected-wrong';
                                labelNote = ' — Your Selection (Wrong)';
                            }
                        } else if (optIdx === ans.correctOption && !ans.isCorrect) {
                            optionClass += ' actual-correct';
                            labelNote = ' — Correct Answer';
                        }
                    %>
                        <div class="<%= optionClass %>">
                            <%= String.fromCharCode(65 + optIdx) %>) <%= optText %> <%= labelNote %>
                        </div>
                    <% }) %>

                    <% if (ans.selectedOption === null) { %>
                        <p style="color: #f87171; font-size: 13px; font-weight: bold; margin-top: 10px; margin-bottom: 0;">
                            ⚠️ Skipped. Correct answer was Option <%= String.fromCharCode(65 + ans.correctOption) %>.
                        </p>
                    <% } %>
                </div>
            </div>
        <% }) %>
    </div>
</div>

</body>
</html>