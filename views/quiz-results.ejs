<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Results - <%= quiz.title %></title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
            margin: 0;
            padding: 25px;
        }
        .container {
            max-width: 1100px;
            margin: auto;
            background: #1e293b;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
            border: 1px solid #334155;
        }
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid #334155;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }
        th, td {
            border: 1px solid #334155;
            padding: 12px;
            text-align: left;
        }
        th {
            background-color: #0f172a;
            color: #94a3b8;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .btn-inspect {
            background: #0284c7;
            color: white;
            padding: 6px 14px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
            font-weight: bold;
        }
        .btn-inspect:hover { background: #0369a1; }
        .answers-panel {
            display: none;
            background: #0f172a;
            border: 1px solid #334155;
            padding: 15px;
            margin-top: 12px;
            border-radius: 6px;
        }
        .q-row {
            padding: 10px 0;
            border-bottom: 1px dashed #334155;
            font-size: 13px;
        }
        .q-row:last-child {
            border-bottom: none;
        }
        .pill-correct {
            color: #4ade80;
            font-weight: bold;
        }
        .pill-wrong {
            color: #f87171;
            font-weight: bold;
        }
        .link-back {
            text-decoration: none;
            color: #38bdf8;
            font-weight: bold;
            font-size: 14px;
        }
    </style>
</head>
<body>

<div class="container">
    <div class="header">
        <div>
            <h2 style="margin: 0; color: #f8fafc;"><%= quiz.title %> — Student Submissions</h2>
            <p style="color: #94a3b8; margin: 4px 0 0 0; font-size: 13px;">
                Subject: <strong><%= quiz.subject %></strong> | Quiz Code: <strong><%= quiz.quizCode %></strong>
            </p>
        </div>
        <a href="/faculty/dashboard" class="link-back">← Back to Dashboard</a>
    </div>

    <% if (results.length === 0) { %>
        <p style="color: #94a3b8; font-style: italic;">No student submissions recorded yet for this quiz.</p>
    <% } else { %>
        <table>
            <thead>
                <tr>
                    <th>Student Name</th>
                    <th>Email</th>
                    <th>Score</th>
                    <th>Percentage</th>
                    <th>Submitted At</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% results.forEach((r) => { %>
                    <tr>
                        <td><strong><%= r.studentName %></strong></td>
                        <td><%= r.studentEmail %></td>
                        <td><%= r.score %> / <%= r.totalQuestions %></td>
                        <td><strong><%= Math.round((r.score / r.totalQuestions) * 100) %>%</strong></td>
                        <td><%= new Date(r.submittedAt).toLocaleString() %></td>
                        <td>
                            <button class="btn-inspect" onclick="toggleDetails('<%= r._id %>')">
                                Inspect Answers ▾
                            </button>

                            <!-- Collapsible Question Breakdown -->
                            <div id="tray-<%= r._id %>" class="answers-panel">
                                <h4 style="margin: 0 0 10px 0; color: #38bdf8;">Question-by-Question Choices:</h4>
                                
                                <% if (!r.answers || r.answers.length === 0) { %>
                                    <p style="color: #94a3b8; font-size: 12px; margin: 0;">Detailed answer history is not available for this earlier attempt.</p>
                                <% } else { %>
                                    <% r.answers.forEach((ans, qNum) => { %>
                                        <div class="q-row">
                                            <div><strong>Q<%= qNum + 1 %>: <%= ans.questionText %></strong></div>
                                            
                                            <% if (ans.selectedOption !== null) { %>
                                                <div style="margin-top: 4px;">
                                                    Selected: <strong>Option <%= String.fromCharCode(65 + ans.selectedOption) %> (<%= ans.options[ans.selectedOption] %>)</strong> 
                                                    <span class="<%= ans.isCorrect ? 'pill-correct' : 'pill-wrong' %>">
                                                        <%= ans.isCorrect ? '✔ Correct' : '✖ Wrong' %>
                                                    </span>
                                                </div>
                                            <% } else { %>
                                                <div style="margin-top: 4px;" class="pill-wrong">⚠️ Skipped / Not Answered</div>
                                            <% } %>

                                            <% if (!ans.isCorrect) { %>
                                                <div style="color: #94a3b8; margin-top: 3px;">
                                                    Correct Option: <strong style="color: #38bdf8;">Option <%= String.fromCharCode(65 + ans.correctOption) %> (<%= ans.options[ans.correctOption] %>)</strong>
                                                </div>
                                            <% } %>
                                        </div>
                                    <% }) %>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</div>

<script>
    function toggleDetails(id) {
        const tray = document.getElementById('tray-' + id);
        tray.style.display = (tray.style.display === 'block') ? 'none' : 'block';
    }
</script>

</body>
</html>