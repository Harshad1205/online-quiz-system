<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assessment Studio — Author Quiz</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        input[type="datetime-local"]::-webkit-calendar-picker-indicator {
            filter: invert(1);
            cursor: pointer;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen selection:bg-indigo-500 selection:text-white relative overflow-x-hidden">

    <!-- Ambient Glow Backdrops -->
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute top-1/2 -right-32 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <form id="quizForm" action="/faculty/create-quiz" method="POST">
        <!-- Top Sticky Header -->
        <header class="border-b border-slate-800/80 bg-slate-950/70 backdrop-blur-xl sticky top-0 z-50">
            <div class="max-w-5xl mx-auto px-6 h-20 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-sky-400 flex items-center justify-center font-bold text-white shadow-lg shadow-indigo-500/20 ring-1 ring-white/20">
                        ✍️
                    </div>
                    <div>
                        <span class="font-extrabold text-lg tracking-tight text-white block leading-none">Assessment Studio</span>
                        <span class="text-[10px] text-slate-400 uppercase tracking-widest font-semibold">Quiz Authoring Suite</span>
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <a href="/faculty/dashboard" 
                       class="text-xs font-semibold text-slate-400 hover:text-slate-200 bg-slate-900 hover:bg-slate-800 border border-slate-700/80 px-4 py-2.5 rounded-xl transition">
                        Discard & Exit
                    </a>
                </div>
            </div>
        </header>

        <!-- Main Studio Body -->
        <main class="max-w-4xl mx-auto px-6 py-10 space-y-8 relative z-10">

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-400 text-xs font-semibold flex items-center gap-2.5">
                    <span class="text-base shrink-0">⚠️</span>
                    <span><%= error %></span>
                </div>
            <% } %>

            <!-- 1. Metadata Configuration Card -->
            <section class="bg-slate-900/80 border border-slate-800 rounded-3xl p-6 md:p-8 shadow-xl space-y-6">
                <div class="flex items-center justify-between pb-4 border-b border-slate-800/80">
                    <div class="flex items-center gap-2.5">
                        <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
                        <h2 class="text-xs font-extrabold uppercase tracking-widest text-slate-300">Exam Parameters</h2>
                    </div>
                    <span class="text-xs text-slate-500 font-medium">Step 1: General Information</span>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Quiz Title</label>
                        <input type="text" name="title" placeholder="e.g. Computer Networks Midterm" required
                            class="w-full bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition shadow-inner">
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Subject / Course Code</label>
                        <input type="text" name="subject" placeholder="e.g. CS-402 Distributed Systems" required
                            class="w-full bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition shadow-inner">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-2">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Duration (Minutes)</label>
                        <div class="relative">
                            <input type="number" id="durationInput" name="duration" value="15" min="1" max="300" required
                                class="w-full bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-sm text-slate-100 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition shadow-inner">
                            <span class="absolute right-4 top-3.5 text-xs font-bold text-slate-500 pointer-events-none">MINS</span>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Submission Deadline</label>
                        <input type="datetime-local" id="deadlineInput" name="deadline"
                            class="w-full bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-sm text-slate-100 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition shadow-inner">
                        
                        <label class="inline-flex items-center gap-2 mt-2.5 cursor-pointer">
                            <input type="checkbox" id="noDeadlineToggle" class="w-4 h-4 rounded bg-slate-950 border-slate-800 text-indigo-600 focus:ring-indigo-500">
                            <span class="text-xs text-slate-400 font-medium">Leave assessment open indefinitely (No expiration date)</span>
                        </label>
                    </div>
                </div>
            </section>

            <!-- 2. Question Queue Header -->
            <div class="flex items-center justify-between pt-2">
                <div class="flex items-center gap-2">
                    <span class="h-6 w-6 rounded-lg bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 flex items-center justify-center font-black text-xs">#</span>
                    <h3 class="text-base font-bold text-white">Questions Repository</h3>
                </div>
                <button type="button" onclick="addQuestion()" 
                    class="bg-slate-900 hover:bg-slate-850 text-indigo-400 border border-indigo-500/30 text-xs font-bold px-4 py-2 rounded-xl transition flex items-center gap-1.5 shadow-sm active:scale-95">
                    <span>+</span> Add Question Card
                </button>
            </div>

            <!-- Dynamic Question Cards Container -->
            <div id="questionsContainer" class="space-y-6">
                <!-- Primary Question Block 1 -->
                <div class="question-panel bg-slate-900/80 border border-slate-800 rounded-3xl p-6 md:p-8 shadow-xl space-y-6 transition hover:border-slate-700" id="qBlock_1">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-800">
                        <span class="q-pill inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-widest text-indigo-400">
                            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span> Question 1
                        </span>
                        <button type="button" class="btn-trash text-xs text-rose-400 hover:text-rose-300 font-semibold px-2 py-1 rounded-lg hover:bg-rose-950/30 transition hidden" onclick="removeQuestion(1)">
                            Remove Question
                        </button>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Question Statement</label>
                        <textarea name="question" rows="2" placeholder="Formulate the prompt or problem statement clearly..." required
                            class="w-full bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition shadow-inner"></textarea>
                    </div>

                    <div class="space-y-3">
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400">
                            Answer Choices <span class="text-emerald-400 font-normal ml-1">(Mark the radio button of the correct answer)</span>
                        </label>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 option-choice-grid">
                            <!-- Option A -->
                            <div class="option-row flex items-center bg-slate-950 border border-emerald-500/60 rounded-2xl p-2.5 transition">
                                <input type="radio" name="correctAnswer_0" value="0" checked onchange="updateCorrectStyle(this)"
                                    class="radio-correct w-4 h-4 text-emerald-600 focus:ring-emerald-500 bg-slate-900 border-slate-700 ml-2 cursor-pointer">
                                <span class="h-8 w-8 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 flex items-center justify-center font-bold text-xs shrink-0 ml-2">A</span>
                                <input type="text" name="option1" placeholder="Option A statement" required
                                    class="w-full bg-transparent px-3 py-1.5 text-xs text-slate-200 placeholder-slate-600 focus:outline-none">
                            </div>

                            <!-- Option B -->
                            <div class="option-row flex items-center bg-slate-950 border border-slate-800 rounded-2xl p-2.5 transition">
                                <input type="radio" name="correctAnswer_0" value="1" onchange="updateCorrectStyle(this)"
                                    class="radio-correct w-4 h-4 text-emerald-600 focus:ring-emerald-500 bg-slate-900 border-slate-700 ml-2 cursor-pointer">
                                <span class="h-8 w-8 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 flex items-center justify-center font-bold text-xs shrink-0 ml-2">B</span>
                                <input type="text" name="option2" placeholder="Option B statement" required
                                    class="w-full bg-transparent px-3 py-1.5 text-xs text-slate-200 placeholder-slate-600 focus:outline-none">
                            </div>

                            <!-- Option C -->
                            <div class="option-row flex items-center bg-slate-950 border border-slate-800 rounded-2xl p-2.5 transition">
                                <input type="radio" name="correctAnswer_0" value="2" onchange="updateCorrectStyle(this)"
                                    class="radio-correct w-4 h-4 text-emerald-600 focus:ring-emerald-500 bg-slate-900 border-slate-700 ml-2 cursor-pointer">
                                <span class="h-8 w-8 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 flex items-center justify-center font-bold text-xs shrink-0 ml-2">C</span>
                                <input type="text" name="option3" placeholder="Option C statement" required
                                    class="w-full bg-transparent px-3 py-1.5 text-xs text-slate-200 placeholder-slate-600 focus:outline-none">
                            </div>

                            <!-- Option D -->
                            <div class="option-row flex items-center bg-slate-950 border border-slate-800 rounded-2xl p-2.5 transition">
                                <input type="radio" name="correctAnswer_0" value="3" onchange="updateCorrectStyle(this)"
                                    class="radio-correct w-4 h-4 text-emerald-600 focus:ring-emerald-500 bg-slate-900 border-slate-700 ml-2 cursor-pointer">
                                <span class="h-8 w-8 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 flex items-center justify-center font-bold text-xs shrink-0 ml-2">D</span>
                                <input type="text" name="option4" placeholder="Option D statement" required
                                    class="w-full bg-transparent px-3 py-1.5 text-xs text-slate-200 placeholder-slate-600 focus:outline-none">
                            </div>
                        </div>
                    </div>

                    <input type="hidden" name="correctAnswer" value="0" class="actual-correct-val">
                </div>
            </div>

            <!-- Add Question Dash Button -->
            <button type="button" onclick="addQuestion()" 
                class="w-full py-4 bg-slate-900/40 hover:bg-slate-900 text-indigo-400 hover:text-indigo-300 border-2 border-dashed border-slate-800 hover:border-indigo-500/40 rounded-3xl text-xs font-bold tracking-wider uppercase transition flex items-center justify-center gap-2">
                <span>+</span> Add Another Question Module
            </button>

            <!-- 3. Launch Summary & Submit Card -->
            <section class="bg-slate-900/90 border border-slate-800 rounded-3xl p-6 md:p-8 backdrop-blur-xl shadow-2xl space-y-6">
                <div class="flex items-center justify-between pb-3 border-b border-slate-800">
                    <h2 class="text-xs font-extrabold uppercase tracking-widest text-slate-300">Assessment Telemetry Preview</h2>
                    <span class="text-xs text-emerald-400 font-bold">Ready to Publish</span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="bg-slate-950/70 border border-slate-800/80 rounded-2xl p-4 text-center">
                        <span class="text-[11px] font-bold uppercase tracking-widest text-slate-500 block mb-1">Total Questions</span>
                        <span id="totalQuestionsCount" class="text-2xl font-black text-indigo-400 font-mono">1</span>
                    </div>

                    <div class="bg-slate-950/70 border border-slate-800/80 rounded-2xl p-4 text-center">
                        <span class="text-[11px] font-bold uppercase tracking-widest text-slate-500 block mb-1">Allocated Time</span>
                        <span id="timeSummary" class="text-2xl font-black text-white font-mono">15 Mins</span>
                    </div>

                    <div class="bg-slate-950/70 border border-slate-800/80 rounded-2xl p-4 text-center">
                        <span class="text-[11px] font-bold uppercase tracking-widest text-slate-500 block mb-1">Submission Policy</span>
                        <span id="expirySummary" class="text-xs font-bold text-slate-300 block mt-2">Open Schedule</span>
                    </div>
                </div>

                <button type="submit" 
                    class="w-full bg-gradient-to-r from-emerald-600 to-teal-500 hover:from-emerald-500 hover:to-teal-400 text-white font-bold py-4 px-6 rounded-2xl shadow-lg shadow-emerald-600/25 transition-all duration-200 text-sm flex items-center justify-center gap-2 cursor-pointer active:scale-[0.99]">
                    ✓ Compile, Generate PIN & Launch Assessment →
                </button>
            </section>

        </main>
    </form>

    <script>
        // Synchronize Deadline Controls
        const noDeadlineToggle = document.getElementById('noDeadlineToggle');
        const deadlineInput = document.getElementById('deadlineInput');
        const expirySummary = document.getElementById('expirySummary');

        const now = new Date();
        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
        deadlineInput.min = now.toISOString().slice(0, 16);

        noDeadlineToggle.addEventListener('change', (e) => {
            if (e.target.checked) {
                deadlineInput.value = '';
                deadlineInput.disabled = true;
                deadlineInput.classList.add('opacity-40');
                expirySummary.innerText = 'Indefinite (Open)';
            } else {
                deadlineInput.disabled = false;
                deadlineInput.classList.remove('opacity-40');
                expirySummary.innerText = deadlineInput.value ? 'Timed Deadline' : 'Open Schedule';
            }
        });

        deadlineInput.addEventListener('change', () => {
            if (deadlineInput.value) {
                noDeadlineToggle.checked = false;
                expirySummary.innerText = 'Timed Deadline';
            }
        });

        // Synchronize Live Duration
        const durationInput = document.getElementById('durationInput');
        const timeSummary = document.getElementById('timeSummary');
        durationInput.addEventListener('input', () => {
            timeSummary.innerText = `${durationInput.value || 0} Mins`;
        });

        // Answer Key Styling Toggle
        function updateCorrectStyle(radio) {
            const parentGrid = radio.closest('.option-choice-grid');
            parentGrid.querySelectorAll('.option-row').forEach(row => {
                row.classList.remove('border-emerald-500/60');
                row.classList.add('border-slate-800');
            });
            
            const selectedRow = radio.closest('.option-row');
            selectedRow.classList.remove('border-slate-800');
            selectedRow.classList.add('border-emerald-500/60');
            
            const panel = radio.closest('.question-panel');
            panel.querySelector('.actual-correct-val').value = radio.value;
        }

        // Reindex Dynamic Panels
        function reindex() {
            const panels = document.querySelectorAll('.question-panel');
            const count = panels.length;
            document.getElementById('totalQuestionsCount').innerText = count;

            panels.forEach((p, idx) => {
                const num = idx + 1;
                p.id = `qBlock_${num}`;
                p.querySelector('.q-pill').innerHTML = `<span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span> Question ${num}`;
                
                p.querySelectorAll('.radio-correct').forEach(r => {
                    r.name = `correctAnswer_${idx}`;
                });

                const delBtn = p.querySelector('.btn-trash');
                if (count > 1) {
                    delBtn.classList.remove('hidden');
                } else {
                    delBtn.classList.add('hidden');
                }
                delBtn.setAttribute('onclick', `removeQuestion(${num})`);
            });
        }

        // Add Question Functionality
        function addQuestion() {
            const panels = document.querySelectorAll('.question-panel');
            const nextIdx = panels.length;
            const nextNum = nextIdx + 1;

            const html = `
                <div class="question-panel bg-slate-900/80 border border-slate-800 rounded-3xl p-6 md:p-8 shadow-xl space-y-6 transition hover:border-slate-700" id="qBlock_${nextNum}">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-800">
                        <span class="q-pill inline-flex items-center gap-2 text-xs font-extrabold uppercase tracking-widest text-indigo-400">
                            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span> Question ${nextNum}
                        </span>
                        <button type="button" class="btn-trash text-xs text-rose-400 hover:text-rose-300 font-semibold px-2 py-1 rounded-lg hover:bg-rose-950/30 transition" onclick="removeQuestion(${nextNum})">
                            Remove Question
                        </button>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Question Statement</label>
                        <textarea name="question" rows="2" placeholder="Formulate the prompt or problem statement clearly..." required
                            class="w-full bg-slate-950 border border-slate-800 rounded-2xl px-4 py-3 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition shadow-inner"></textarea>
                    </div>

                    <div class="space-y-3">
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400">
                            Answer Choices <span class="text-emerald-400 font-normal ml-1">(Mark the radio button of the correct answer)</span>
                        </label>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 option-choice-grid">
                            <div class="option-row flex items-center bg-slate-950 border border-emerald-500/60 rounded-2xl p-2.5 transition">
                                <input type="radio" name="correctAnswer_${nextIdx}" value="0" checked onchange="updateCorrectStyle(this)"
                                    class="radio-correct w-4 h-4 text-emerald-600 focus:ring-emerald-500 bg-slate-900 border-slate-700 ml-2 cursor-pointer">
                                <span class="h-8 w-8 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 flex items-center justify-center font-bold text-xs shrink-0 ml-2">A</span>
                                <input type="text" name="option1" placeholder="Option A statement" required
                                    class="w-full bg-transparent px-3 py-1.5 text-xs text-slate-200 placeholder-slate-600 focus:outline-none">
                            </div>

                            <div class="option-row flex items-center bg-slate-950 border border-slate-800 rounded-2xl p-2.5 transition">
                                <input type="radio" name="correctAnswer_${nextIdx}" value="1" onchange="updateCorrectStyle(this)"
                                    class="radio-correct w-4 h-4 text-emerald-600 focus:ring-emerald-500 bg-slate-900 border-slate-700 ml-2 cursor-pointer">
                                <span class="h-8 w-8 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 flex items-center justify-center font-bold text-xs shrink-0 ml-2">B</span>
                                <input type="text" name="option2" placeholder="Option B statement" required
                                    class="w-full bg-transparent px-3 py-1.5 text-xs text-slate-200 placeholder-slate-600 focus:outline-none">
                            </div>

                            <div class="option-row flex items-center bg-slate-950 border border-slate-800 rounded-2xl p-2.5 transition">
                                <input type="radio" name="correctAnswer_${nextIdx}" value="2" onchange="updateCorrectStyle(this)"
                                    class="radio-correct w-4 h-4 text-emerald-600 focus:ring-emerald-500 bg-slate-900 border-slate-700 ml-2 cursor-pointer">
                                <span class="h-8 w-8 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 flex items-center justify-center font-bold text-xs shrink-0 ml-2">C</span>
                                <input type="text" name="option3" placeholder="Option C statement" required
                                    class="w-full bg-transparent px-3 py-1.5 text-xs text-slate-200 placeholder-slate-600 focus:outline-none">
                            </div>

                            <div class="option-row flex items-center bg-slate-950 border border-slate-800 rounded-2xl p-2.5 transition">
                                <input type="radio" name="correctAnswer_${nextIdx}" value="3" onchange="updateCorrectStyle(this)"
                                    class="radio-correct w-4 h-4 text-emerald-600 focus:ring-emerald-500 bg-slate-900 border-slate-700 ml-2 cursor-pointer">
                                <span class="h-8 w-8 rounded-xl bg-slate-900 text-slate-400 border border-slate-800 flex items-center justify-center font-bold text-xs shrink-0 ml-2">D</span>
                                <input type="text" name="option4" placeholder="Option D statement" required
                                    class="w-full bg-transparent px-3 py-1.5 text-xs text-slate-200 placeholder-slate-600 focus:outline-none">
                            </div>
                        </div>
                    </div>

                    <input type="hidden" name="correctAnswer" value="0" class="actual-correct-val">
                </div>
            `;

            document.getElementById('questionsContainer').insertAdjacentHTML('beforeend', html);
            reindex();

            const newlyAdded = document.getElementById(`qBlock_${nextNum}`);
            newlyAdded.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function removeQuestion(index) {
            const el = document.getElementById(`qBlock_${index}`);
            if (el) {
                el.remove();
                reindex();
            }
        }
    </script>
</body>
</html>