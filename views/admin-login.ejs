<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Portal - Sign In</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #0f172a;
            margin: 0;
            padding: 50px 20px;
        }
        .admin-login-box {
            max-width: 400px;
            margin: auto;
            background: #1e293b;
            padding: 35px 30px;
            border-radius: 8px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
            color: #f8fafc;
            border: 1px solid #334155;
        }
        h2 {
            margin-top: 0;
            color: #f8fafc;
            text-align: center;
        }
        .badge-admin {
            display: block;
            text-align: center;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #38bdf8;
            margin-bottom: 20px;
            font-weight: bold;
        }
        .form-group {
            margin-bottom: 18px;
        }
        label {
            display: block;
            font-size: 13px;
            font-weight: bold;
            margin-bottom: 6px;
            color: #cbd5e1;
        }
        input[type="email"], input[type="password"] {
            width: 100%;
            padding: 10px;
            box-sizing: border-box;
            background: #0f172a;
            border: 1px solid #475569;
            color: #ffffff;
            border-radius: 4px;
            font-size: 14px;
        }
        input[type="email"]:focus, input[type="password"]:focus {
            outline: none;
            border-color: #38bdf8;
        }
        .alert-error {
            background-color: #450a0a;
            color: #fca5a5;
            padding: 10px;
            border-radius: 4px;
            margin-bottom: 15px;
            font-size: 13px;
            border: 1px solid #7f1d1d;
        }
        .btn-admin {
            width: 100%;
            background-color: #0284c7;
            color: #ffffff;
            padding: 11px;
            border: none;
            border-radius: 4px;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
        }
        .btn-admin:hover {
            background-color: #0369a1;
        }
        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #94a3b8;
            font-size: 13px;
            text-decoration: none;
        }
        .back-link:hover {
            color: #f8fafc;
        }
    </style>
</head>
<body>

<div class="admin-login-box">
    <h2>🛡️ Control Center</h2>
    <span class="badge-admin">Authorized Administrators Only</span>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-error">
            <%= error %>
        </div>
    <% } %>

    <form action="/admin/login" method="POST">
        <div class="form-group">
            <label for="email">Admin Email</label>
            <input type="email" id="email" name="email" placeholder="admin@college.edu.in" required>
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" placeholder="••••••••" required>
        </div>

        <button type="submit" class="btn-admin">Authenticate & Login</button>
    </form>

    <a href="/faculty/login" class="back-link">← Switch to Faculty Portal</a>
</div>

</body>
</html>